# QR MASTER Environment Variables

# Database connection (PostgreSQL / Supabase)
# 1. Transaction Connection Pooler (PgBouncer/Supavisor - Port 6543): Use for runtime Next.js app
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Session Connection (Port 5432): Used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication secret (Used to sign JWT session tokens and hash IP addresses for LGPD)
# Generate a strong 32+ character random string in production (e.g. openssl rand -hex 32)
AUTH_SECRET="your-32-character-random-production-secret-here"

# Public Application URL (Base URL used for dynamic QR code redirects, file URLs and client previews)
# In production, configure with your production domain (e.g. https://your-production-domain.com)
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# Supabase Storage Configuration (Production Cloud Object Storage)
# Bucket name in Supabase: Create a bucket named "qrmaster-files"
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="qrmaster-files"

# Stripe Billing & Subscriptions (SaaS Payments)
# Secret key from Stripe Dashboard (Developers > API keys)
STRIPE_SECRET_KEY="sk_test_51... or sk_live_51..."

# Stripe Webhook Signing Secret (Developers > Webhooks > Endpoint Signing secret)
# Endpoint URL in Stripe: https://your-production-domain.com/api/webhooks/billing
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: Specific Stripe recurring price IDs for PRO and BUSINESS
# If left unset, QR MASTER dynamically bills R$ 39,90/month (PRO) and R$ 99,90/month (BUSINESS)
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_BUSINESS="price_..."


